# 复制本文件为 secrets.properties（与 settings.gradle.kts 同级），填入你自己的密钥。
# secrets.properties 已被 .gitignore 忽略，不会提交到仓库，请妥善保管。
# 不填则对应云端功能（视频瘦身 / 画发丝）调用时会提示“未配置密钥”。

# 腾讯云（人脸美颜，可选；每月 1000 次免费）
# 控制台：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 硅基流动 SiliconFlow（AI 生成头发丝用；注册送免费额度）
# 地址：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# 视频瘦身端点（没有通用免费 API，需自备云函数/服务端地址）
# 在 app/src/main/java/com/example/magicbeauty/api/ApiConfig.kt 的
# videoSlimEndpoint 变量中填写，或在代码里赋值 ApiConfig.videoSlimEndpoint = "..."
